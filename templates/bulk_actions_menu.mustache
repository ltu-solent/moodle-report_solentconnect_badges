{{!
    @template report_solentconnect_badges/bulk_actions_menu

    Provides the html for bulk actions

    Example context (json):
    {
        "showbulkactions": true,
        "id": "bulk-actions-menu",
        "attributes": [
            {
                "name": "data-some-attribute",
                "value": "some-value"
            }
        ],
        "actions": [
            {
                "value": "update",
                "name": "Update"
            },
            {
                "value": "delete",
                "name": "Delete"
            }
        ],
        "perpage": true
    }
}}


<br />
<div class="d-inline-block w-100">
    {{#showbulkactions}}
    <div class="buttons float-left">
        <div class="form-inline pl-1">
            <label for="{{id}}">{{#str}}withselectedbadges, report_solentconnect_badges{{/str}}</label>
            <select id="{{id}}" class="select custom-select ml-4" {{#attributes}}{{name}}="{{value}}" {{/attributes}}>
                <option value="">{{#str}}choosedots{{/str}}</option>
                {{#actions}}
                <option value="{{value}}">{{name}}</option>
                {{/actions}}
            </select>
        </div>
    </div>
    {{/showbulkactions}}
    <div class="float-right">
        {{#perpage}}
            {{> core/single_select}}
        {{/perpage}}
    </div>
</div>