<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="report/solentconnect_badges/db" VERSION="20260930" COMMENT="XMLDB file for Moodle report/solentconnect_badges/db"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="report_solentconnect_badges" COMMENT="List of badges to be exported to SolentConnect">
        <FIELDS>
            <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true"/>
            <FIELD NAME="badgeissuedid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="false"/>
            <FIELD NAME="timeexported" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" SEQUENCE="false" DEFAULT="0"/>
        </FIELDS>
        <KEYS>
            <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        </KEYS>
        <INDEXES>
            <INDEX NAME="badgeissuedid_idx" UNIQUE="true" FIELDS="badgeissuedid"/>
        </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>